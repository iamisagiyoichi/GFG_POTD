class Solution {
    public int formPyramid(int[] arr) {
        int n = arr.length;
        long[] left = new long[n];
        long[] right = new long[n];

        left[0] = Math.min(1L, (long) arr[0]);

        for (int i = 1; i < n; i++) {
            left[i] = Math.min((long) arr[i], left[i - 1] + 1);
        }

        right[n - 1] = Math.min(1L, (long) arr[n - 1]);

        for (int i = n - 2; i >= 0; i--) {
            right[i] = Math.min((long) arr[i], right[i + 1] + 1);
        }

        long total = 0;
        long maxKeep = 0;

        for (int i = 0; i < n; i++) {
            total += arr[i];

            long height = Math.min(left[i], right[i]);
            maxKeep = Math.max(maxKeep, height * height);
        }

        return (int) (total - maxKeep);
    }
}
